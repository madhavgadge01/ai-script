# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-3.8-flash

# SQLite Database
DATABASE_URL=sqlite:///storage/uninotes.db

# Notes Guru Admin Integration
NOTES_GURU_API_BASE=https://notes-guru-production.up.railway.app/api
NOTES_GURU_ADMIN_TOKEN=

# Budget & Safety Controls
MAX_TOKENS_PER_DOC=100000
MAX_COST_USD_PER_DOC=0.25
AUTO_APPROVE_COST=false
